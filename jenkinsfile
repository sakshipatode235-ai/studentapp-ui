pipeline{
    agent{
        label 'worker'
    }
    
    tools{

        maven 'maven'
        
    }

    environment{
        My_aws_cred = credentials('aws-cred')
    }

    stages{
        stage('checkout'){
            steps{

                git 'https://github.com/sakshipatode235-ai/studentapp-ui.git'
            }
        }
        stage ('build'){
            steps{

                sh 'mvn clean package'
            }
            post {
                success{
                    archiveArtifacts artifacts: '**/target/*.war' , fingerprint:true
                }
            }
        }
        stage('Artifact to s3'){
            steps{

                sh ' aws s3 cp target/*war s3://argurate.spacee/artifact/student.war'
            }

        }
        stage('SonarQube-Analysis'){
            steps{
                withSonarQubeEnv('sonar'){
                    sh'mvn sonar:sonar'

                }
            }
        }
    }
}